# Set HOST=0.0.0.0 for container/hosted deployments only after configuring auth, HTTPS and rate limiting.
PORT=8000
HOST=127.0.0.1
API_KEY=
MAX_AUDIO_MB=30
MAX_CONCURRENT=2
MAX_WINDOWS=3
RATE_LIMIT_PER_MINUTE=20
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
SHAZAM_TIMEZONE=America/Chicago
REQUEST_TIMEOUT_MS=20000
MAX_RETRIES=2
ENABLE_REMOTE_URLS=false
SHAZAM_MUSICKIT_TOKEN=
